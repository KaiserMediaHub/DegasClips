[Unit]
Description=Degas Clips Web App
After=network.target

[Service]
User=root
WorkingDirectory=/opt/degas-clips
EnvironmentFile=/opt/degas-clips/.env
ExecStart=/opt/degas-clips/venv/bin/gunicorn app:app --workers 1 --timeout 300 --bind 0.0.0.0:5000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
